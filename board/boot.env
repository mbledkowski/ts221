firmware_layout=1
active_slot=A
rollback_slot=A
release_sequence=0
upgrade_available=0
bootcount=0
bootlimit=3
bootdelay=3
kernel_addr_r=0x00800000
bootdisk=if sata device ${disk} && sata read ${kernel_addr_r} ${lba} 0x8000 && iminfo ${kernel_addr_r}; then bootm ${kernel_addr_r}; fi; false
bootslot=if test "${slot}" = A || test "${slot}" = B; then setenv lba 0x800; setenv rootdev /dev/md0; if test "${slot}" = B; then setenv lba 0x20800; setenv rootdev /dev/md1; fi; setenv bootargs firmware.layout=1 firmware.slot=${slot} console=ttyS0,115200 root=${rootdev} rootwait rootdelay=10 rw raid=autodetect panic=10; setenv disk 0; run bootdisk; setenv disk 1; run bootdisk; fi; false
bootcmd=sleep 10; if sata init; then setenv slot ${active_slot}; run bootslot; setenv slot ${rollback_slot}; run bootslot; fi
altbootcmd=sleep 10; if sata init; then setenv slot ${rollback_slot}; run bootslot; fi
