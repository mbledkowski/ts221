 #include <dm.h>
+#include <clk.h>
 #include <log.h>
 #include <malloc.h>
 #include <dm/device-internal.h>
@@ -56,6 +57,7 @@
 
 struct mvebu_pcie {
 	struct pci_controller hose;
+	struct clk clk;
 	void __iomem *base;
 	void __iomem *membase;
 	struct resource mem;
@@ -76,6 +78,25 @@
 	u32 cfgcache[(0x3c - 0x10) / 4];
 };
 
+static int mvebu_pcie_enable_clock(struct mvebu_pcie *pcie, ofnode node)
+{
+	int ret;
+
+	ret = clk_get_by_index_nodev(node, 0, &pcie->clk);
+	if (ret == -ENOENT)
+		return 0;
+	if (ret) {
+		printf("%s: cannot get clock: %d\n", pcie->name, ret);
+		return ret;
+	}
+
+	ret = clk_enable(&pcie->clk);
+	if (ret)
+		printf("%s: cannot enable clock: %d\n", pcie->name, ret);
+
+	return ret;
+}
+
 static inline bool mvebu_pcie_link_up(struct mvebu_pcie *pcie)
 {
 	u32 val;
@@ -420,6 +441,17 @@
 	u32 reg;
 	int ret;
 
+	/*
+	 * Enable the port clock at probe time, not bind time: the clock
+	 * provider can live on a bus that driver model binds after this
+	 * controller's bus, so a bind-time lookup fails with -ENODEV and
+	 * aborts enumeration (observed on Kirkwood, whose gate-clock node
+	 * sits under the ocp bus while this controller sits under mbus).
+	 */
+	ret = mvebu_pcie_enable_clock(pcie, dev_ofnode(dev));
+	if (ret)
+		return ret;
+
 	/* Request for optional PERST# GPIO */
 	ret = gpio_request_by_name(dev, "reset-gpios", 0, &pcie->reset_gpio, GPIOD_IS_OUT);
 	if (ret && ret != -ENOENT) {
@@ -786,13 +818,18 @@
 		ports_count++;
 	}
 
