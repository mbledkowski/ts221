From 0e66bac6bcca351818aca1d7b9e99fb191be9ddb Mon Sep 17 00:00:00 2001
Date: Mon, 31 Aug 2026 20:33:24 +0200
Subject: [PATCH 4/6] clk: kirkwood: enable PCIe clocks through driver model

Add a driver for the existing Kirkwood clock-gating binding and make
the MVEBU PCIe driver enable each port clock before accessing its
controller registers.

diff --git a/drivers/clk/Kconfig b/drivers/clk/Kconfig
index c2da7b3938..697c032f7e 100644
--- a/drivers/clk/Kconfig
+++ b/drivers/clk/Kconfig
@@ -168,6 +168,13 @@ config CLK_K210_SET_RATE
 	  Add functionality to calculate new rates for K210 PLLs. Enabling this
 	  feature adds around 1K to U-Boot's final size.
 
+config CLK_KIRKWOOD
+	bool "Marvell Kirkwood clock gating support"
+	depends on CLK && ARCH_KIRKWOOD
+	help
+	  Enable the peripheral clock-gating controller found on Marvell
+	  Kirkwood SoCs.
+
 config CLK_MPC83XX
 	bool "Enable MPC83xx clock driver"
 	depends on CLK && MPC83xx
diff --git a/drivers/clk/Makefile b/drivers/clk/Makefile
index 5f0c0d8a5c..4178a9d13a 100644
--- a/drivers/clk/Makefile
+++ b/drivers/clk/Makefile
@@ -38,6 +38,7 @@ obj-$(CONFIG_CLK_CDCE9XX) += clk-cdce9xx.o
 obj-$(CONFIG_CLK_EXYNOS) += exynos/
 obj-$(CONFIG_CLK_HSDK) += clk-hsdk-cgu.o
 obj-$(CONFIG_CLK_K210) += clk_k210.o
+obj-$(CONFIG_CLK_KIRKWOOD) += clk-kirkwood.o
 obj-$(CONFIG_CLK_MPC83XX) += mpc83xx_clk.o
 obj-$(CONFIG_CLK_MPFS) += microchip/
