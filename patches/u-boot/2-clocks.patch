diff --git a/drivers/clk/clk-kirkwood.c b/drivers/clk/clk-kirkwood.c
new file mode 100644
index 0000000000..91b243806a
--- /dev/null
+++ b/drivers/clk/clk-kirkwood.c
@@ -0,0 +1,78 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * Marvell Kirkwood peripheral clock gates
+ */
+
+#include <clk-uclass.h>
+#include <dm.h>
+#include <asm/io.h>
+#include <linux/bitops.h>
+
+#define KIRKWOOD_CLK_MAX_ID	20
+
+/* DUNIT (bit 6) drives DRAM and must never be gated while U-Boot runs. */
+#define KIRKWOOD_CLK_GATE_MASK	(BIT(0) | BIT(2) | BIT(3) | BIT(4) | \
+				 BIT(5) | BIT(7) | BIT(8) | BIT(9) | \
+				 GENMASK(20, 14))
+
+struct kirkwood_clk_priv {
+	void __iomem *reg;
+};
+
+static int kirkwood_clk_request(struct clk *clk)
+{
+	if (clk->id > KIRKWOOD_CLK_MAX_ID ||
+	    !(KIRKWOOD_CLK_GATE_MASK & BIT(clk->id)))
+		return -EINVAL;
+
+	return 0;
+}
+
+static int kirkwood_clk_enable(struct clk *clk)
+{
+	struct kirkwood_clk_priv *priv = dev_get_priv(clk->dev);
+
+	setbits_le32(priv->reg, BIT(clk->id));
+
+	return 0;
+}
+
+static int kirkwood_clk_disable(struct clk *clk)
+{
+	struct kirkwood_clk_priv *priv = dev_get_priv(clk->dev);
+
+	clrbits_le32(priv->reg, BIT(clk->id));
+
+	return 0;
+}
+
+static const struct clk_ops kirkwood_clk_ops = {
+	.request = kirkwood_clk_request,
+	.enable = kirkwood_clk_enable,
+	.disable = kirkwood_clk_disable,
+};
+
+static int kirkwood_clk_probe(struct udevice *dev)
+{
+	struct kirkwood_clk_priv *priv = dev_get_priv(dev);
+
+	priv->reg = dev_remap_addr(dev);
+	if (!priv->reg)
+		return -EINVAL;
+
+	return 0;
+}
+
+static const struct udevice_id kirkwood_clk_ids[] = {
+	{ .compatible = "marvell,kirkwood-gating-clock" },
+	{ }
+};
+
+U_BOOT_DRIVER(kirkwood_clk) = {
+	.name = "kirkwood_clk",
+	.id = UCLASS_CLK,
+	.of_match = kirkwood_clk_ids,
+	.ops = &kirkwood_clk_ops,
+	.probe = kirkwood_clk_probe,
+	.priv_auto = sizeof(struct kirkwood_clk_priv),
+};
diff --git a/drivers/pci/Kconfig b/drivers/pci/Kconfig
index 39df0e776d..a533755b3c 100644
--- a/drivers/pci/Kconfig
