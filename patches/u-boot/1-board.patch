Subject: [PATCH] kirkwood: Q703 board and Ethernet support

Derived from the scratchpad board port. Shared raw-disk A/B boot environment,
redundant SPI state and no factory MAC or duplicate device-tree sources.

diff --git a/arch/arm/mach-kirkwood/Kconfig b/arch/arm/mach-kirkwood/Kconfig
index f1ccedba5d74e400f53420a91e95adb569b56cf5..9e74a56a9aaa6a3c0a1efc5cb59f5f50743e4323 100644
--- a/arch/arm/mach-kirkwood/Kconfig
+++ b/arch/arm/mach-kirkwood/Kconfig
@@ -149,6 +149,12 @@ config TARGET_NSA325
 	select KW88F6281
 	select KIRKWOOD_COMMON
 
+config TARGET_QNAP_TS221
+	bool "QNAP TS-221 / Fujitsu CELVIN Q703"
+	select FEROCEON_88FR131
+	select KW88F6281
+	select KIRKWOOD_COMMON
+
 config TARGET_SBx81LIFKW
 	bool "Allied Telesis SBx81GS24/SBx81GT40/SBx81XS6/SBx81XS16"
 	select FEROCEON_88FR131
@@ -196,6 +202,7 @@ source "board/Seagate/goflexhome/Kconfig"
 source "board/Seagate/nas220/Kconfig"
 source "board/zyxel/nsa310s/Kconfig"
 source "board/zyxel/nsa325/Kconfig"
+source "board/qnap/ts221/Kconfig"
 source "board/alliedtelesis/SBx81LIFKW/Kconfig"
 source "board/alliedtelesis/SBx81LIFXCAT/Kconfig"
 
diff --git a/drivers/net/Makefile b/drivers/net/Makefile
index 5e90183d090ef0a602d7b0eeb82aafe3455e5648..db07d1dcbb567237b2b5739000d895810c14ef81 100644
--- a/drivers/net/Makefile
+++ b/drivers/net/Makefile
@@ -78,6 +78,8 @@ obj-$(CONFIG_MT7620_ETH) += mt7620-eth.o
 obj-$(CONFIG_MT7628_ETH) += mt7628-eth.o
 obj-$(CONFIG_MV88E6XXX) += mv88e6xxx.o
 obj-$(CONFIG_MVGBE) += mvgbe.o
+# ARMv5 MVGBE DMA descriptor publication needs CP15 DSB, unavailable in Thumb.
+CFLAGS_mvgbe.o := -marm
 obj-$(CONFIG_MVMDIO) += mvmdio.o
 obj-$(CONFIG_MVNETA) += mvneta.o
 obj-$(CONFIG_MVPP2) += mvpp2.o
diff --git a/drivers/net/mvgbe.c b/drivers/net/mvgbe.c
index 107a33aa9f54a480ecfabd3c2344d49050efcede..754c3311b4a178a80aa03c30d50133f3c3253605 100644
--- a/drivers/net/mvgbe.c
+++ b/drivers/net/mvgbe.c
@@ -34,6 +34,7 @@ DECLARE_GLOBAL_DATA_PTR;
 #define MV_PHY_ADR_REQUEST 0xee
 #define MVGBE_SMI_REG (((struct mvgbe_registers *)MVGBE0_BASE)->smi)
 #define MVGBE_PGADR_REG	22
+#define MVGBE_TX_TIMEOUT_MS	1000
 
 #if defined(CONFIG_PHYLIB) || defined(CONFIG_MII) || defined(CONFIG_CMD_MII)
 static int smi_wait_ready(struct mvgbe_device *dmvgbe)
@@ -184,6 +185,7 @@ static int smi_reg_write(struct mii_dev *bus, int phy_adr, int devad,
 static void stop_queue(u32 * qreg)
 {
 	u32 reg_data;
+	ulong start;
 
 	reg_data = readl(qreg);
 
@@ -192,12 +194,18 @@ static void stop_queue(u32 * qreg)
 		writel((reg_data << 8), qreg);
 
 		/* Wait for all queue activity to terminate. */
+		start = get_timer(0);
 		do {
 			/*
 			 * Check port cause register that all queues
 			 * are stopped
 			 */
 			reg_data = readl(qreg);
+			if (get_timer(start) > MVGBE_TX_TIMEOUT_MS) {
+				printf("queue stop timeout: qreg=%p value=%08x\n",
+				       qreg, reg_data);
+				break;
+			}
 		}
 		while (reg_data & 0xFF);
 	}
@@ -456,7 +464,7 @@ static int __mvgbe_init(struct mvgbe_device *dmvgbe, u8 *enetaddr,
 	/* Assignment of Rx CRDB of given RXUQ */
 	MVGBE_REG_WR(regs->rxcdp[RXUQ], (u32) dmvgbe->p_rxdesc_curr);
 	/* ensure previous write is done before enabling Rx DMA */
-	isb();
+	wmb();
 	/* Enable port Rx. */
 	MVGBE_REG_WR(regs->rqc, (1 << RXUQ));
 
@@ -505,6 +552,8 @@ static int __mvgbe_send(struct mvgbe_device *dmvgbe, void *dataptr,
 	void *p = (void *)dataptr;
 	u32 cmd_sts;
 	u32 txuq0_reg_addr;
+	struct mvgbe_txdesc *p_txdesc_next = p_txdesc + 1;
+	ulong start;
 
 	/* Copy buffer if it's misaligned */
 	if ((u32) dataptr & 0x07) {
@@ -520,17 +568,24 @@ static int __mvgbe_send(struct mvgbe_device *dmvgbe, void *dataptr,
 
 	p_txdesc->cmd_sts = MVGBE_ZERO_PADDING | MVGBE_GEN_CRC;
 	p_txdesc->cmd_sts |= MVGBE_TX_FIRST_DESC | MVGBE_TX_LAST_DESC;
-	p_txdesc->cmd_sts |= MVGBE_BUFFER_OWNED_BY_DMA;
-	p_txdesc->cmd_sts |= MVGBE_TX_EN_INTERRUPT;
+	p_txdesc->l4i_chk = 0;
 	p_txdesc->buf_ptr = (u8 *) p;
 	p_txdesc->byte_cnt = datasize;
+	/* Stop after one frame at an explicit, non-DMA-owned ring sentinel. */
+	memset(p_txdesc_next, 0, sizeof(*p_txdesc_next));
+	p_txdesc_next->nxtdesc_p = p_txdesc;
+	p_txdesc->nxtdesc_p = p_txdesc_next;
+	/* Publish descriptor fields before transferring ownership to DMA. */
+	wmb();
+	p_txdesc->cmd_sts |= MVGBE_BUFFER_OWNED_BY_DMA | MVGBE_TX_EN_INTERRUPT;
+	wmb();
 
 	/* Set this tc desc as zeroth TXUQ */
 	txuq0_reg_addr = (u32)&regs->tcqdp[TXUQ];
 	writel((u32) p_txdesc, txuq0_reg_addr);
 
-	/* ensure tx desc writes above are performed before we start Tx DMA */
-	isb();
+	/* Ensure descriptor pointer and ownership reach DMA before queue enable. */
+	wmb();
 
 	/* Apply send command using zeroth TXUQ */
 	MVGBE_REG_WR(regs->tqc, (1 << TXUQ));
@@ -539,6 +594,7 @@ static int __mvgbe_send(struct mvgbe_device *dmvgbe, void *dataptr,
 	 * wait for packet xmit completion
 	 */
 	cmd_sts = readl(&p_txdesc->cmd_sts);
+	start = get_timer(0);
 	while (cmd_sts & MVGBE_BUFFER_OWNED_BY_DMA) {
 		/* return fail if error is detected */
 		if ((cmd_sts & (MVGBE_ERROR_SUMMARY | MVGBE_TX_LAST_FRAME)) ==
@@ -547,7 +603,12 @@ static int __mvgbe_send(struct mvgbe_device *dmvgbe, void *dataptr,
 			printf("Err..(%s) in xmit packet\n", __func__);
 			return -1;
 		}
+		if (get_timer(start) > MVGBE_TX_TIMEOUT_MS) {
+			printf("TX timeout: cmd=%08x tqc=%08x psc0=%08x\n",
+			       cmd_sts, readl(&regs->tqc), readl(&regs->psc0));
+			return -ETIMEDOUT;
+		}
 		cmd_sts = readl(&p_txdesc->cmd_sts);
-	};
+	}
 	return 0;
 }
@@ -672,7 +725,7 @@ static int mvgbe_alloc_buffers(struct mvgbe_device *dmvgbe)
 	if (!dmvgbe->p_aligned_txbuf)
 		goto error3;
 
-	dmvgbe->p_txdesc = memalign(PKTALIGN, sizeof(struct mvgbe_txdesc) + 1);
+	dmvgbe->p_txdesc = memalign(PKTALIGN, 2 * sizeof(struct mvgbe_txdesc));
 	if (!dmvgbe->p_txdesc)
 		goto error4;
 
