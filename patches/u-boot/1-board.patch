diff --git a/board/qnap/ts221/kwbimage.cfg b/board/qnap/ts221/kwbimage.cfg
new file mode 100644
index 0000000000000000000000000000000000000000..8a996978ae795a6c02e0dcaa5df2301b48b053e5
--- /dev/null
+++ b/board/qnap/ts221/kwbimage.cfg
@@ -0,0 +1,43 @@
+# SPDX-License-Identifier: GPL-2.0-or-later
+#
+# Extracted from stock QNAP TS-221 / Q703 mtd0
+# (U-Boot 1.1.4 Marvell 3.5.3, SPI KWB v0).
+# Do not copy NSA325 DDR timings.
+#
+BOOT_FROM	spi
+
+# SOC registers from the original KWB extension
+# header. Maximum KWBIMAGE_MAX_CONFIG entries.
+
+DATA 0xFFD100E0 0x1B1B9B9B	# RGMII pad voltage
+DATA 0xFFD01400 0x4301503C	# DDR Configuration
+DATA 0xFFD01404 0xB9843000	# DDR Controller Control Low
+DATA 0xFFD01408 0x33136663	# DDR Timing (Low)
+DATA 0xFFD0140C 0x16000C3A	# DDR Timing (High)
+DATA 0xFFD01410 0x04000000	# DDR Address Control
+DATA 0xFFD01414 0x00000000	# DDR Open Pages Control
+DATA 0xFFD01418 0x00000000	# DDR Operation
+DATA 0xFFD0141C 0x00000672	# DDR Mode
+DATA 0xFFD01420 0x00000040	# DDR Extended Mode
+DATA 0xFFD01424 0x0000314F	# DDR Controller Control High
+DATA 0xFFD01428 0x000D6720	# DDR ODT Read Timing
+DATA 0xFFD0147C 0x0000B571	# DDR ODT Write Timing
+DATA 0xFFD01504 0x1FFFFFF1	# CS0 Size
+DATA 0xFFD01508 0x20000000	# CS1 Base
+DATA 0xFFD0150C 0x1FFFFFF5	# CS1 Size
+DATA 0xFFD01514 0x00FFFFF0	# CS2 Size
+DATA 0xFFD0151C 0x00FFFFF0	# CS3 Size
+DATA 0xFFD01494 0x00110000	# DDR ODT Control (Low)
+DATA 0xFFD01498 0x00000000	# DDR ODT Control (High)
+DATA 0xFFD0149C 0x0000E803	# CPU ODT Control
+DATA 0xFFD015D0 0x00000630
+DATA 0xFFD015D4 0x00000046
+DATA 0xFFD015D8 0x00000008
+DATA 0xFFD015DC 0x00000000
+DATA 0xFFD015E0 0x00000003
+DATA 0xFFD015E4 0x00203C18
+DATA 0xFFD01620 0x00680000
+DATA 0xFFD01480 0x00000001	# DDR init enable
+DATA 0xFFD20134 0x66666666
+DATA 0xFFD20138 0x66666666
+DATA 0x0 0x0
diff --git a/board/qnap/ts221/ts221.c b/board/qnap/ts221/ts221.c
new file mode 100644
index 0000000000000000000000000000000000000000..76f41921ffd42589cc286c8692dae24039b4b0dc
--- /dev/null
+++ b/board/qnap/ts221/ts221.c
@@ -0,0 +1,102 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * QNAP TS-221 / Fujitsu CELVIN Q703
+ *
+ * SPI NOR, two SATA ports, 88F6282, 1 GiB DRAM.
+ * MPP list follows the TS-219 family Linux DT (SPI, UART,
+ * TWSI, SATA activity) plus documented GPIOs 36/37/43/44.
+ */
+
+#include <init.h>
+#include <netdev.h>
+#include <asm/arch/cpu.h>
+#include <asm/arch/soc.h>
+#include <asm/arch/mpp.h>
+#include <asm/global_data.h>
+#include <asm/io.h>
+
+DECLARE_GLOBAL_DATA_PTR;
+
+int board_early_init_f(void)
+{
+	u32 reg;
+
+	/*
+	 * Leave GPIO output enables at reset defaults until
+	 * LED wiring is measured on hardware.
+	 */
+	mvebu_config_gpio(0, 0, 0, 0);
+
+	static const u32 kwmpp_config[] = {
+		MPP0_SPI_SCn,
+		MPP1_SPI_MOSI,
+		MPP2_SPI_SCK,
+		MPP3_SPI_MISO,
+		MPP4_GPIO,
+		MPP5_GPO,
+		MPP6_SYSRST_OUTn,
+		MPP7_GPO,
+		MPP8_TW_SDA,
+		MPP9_TW_SCK,
+		MPP10_UART0_TXD,
+		MPP11_UART0_RXD,
+		MPP12_GPO,
+		MPP13_UART1_TXD,
+		MPP14_UART1_RXD,
+		MPP15_GPIO,
+		MPP16_GPIO,
+		MPP17_GPIO,
+		MPP18_GPO,
+		MPP19_GPO,
+		MPP20_SATA1_ACTn,
+		MPP21_SATA0_ACTn,
+		MPP22_GPIO,
+		MPP23_GPIO,
+		MPP24_GPIO,
+		MPP25_GPIO,
+		MPP26_GPIO,
+		MPP27_GPIO,
+		MPP28_GPIO,
+		MPP29_GPIO,
+		MPP30_GPIO,
+		MPP31_GPIO,
+		MPP32_GPIO,
+		MPP33_GPIO,
+		MPP34_GPIO,
+		MPP35_GPIO,
+		MPP36_GPIO,	/* RAM size strap */
+		MPP37_GPIO,	/* Reset button */
+		MPP38_GPIO,
+		MPP39_GPIO,
+		MPP40_GPIO,
+		MPP41_GPIO,
+		MPP42_GPIO,
+		MPP43_GPIO,	/* USB Copy button */
+		MPP44_GPIO,	/* board id strap */
+		MPP45_GPIO,
+		MPP46_GPIO,
+		MPP47_GPIO,
+		MPP48_GPIO,
+		MPP49_GPIO,
+		0
+	};
+
+	kirkwood_mpp_conf(kwmpp_config, NULL);
+
+	/* Release GE0 from reset without touching the absent GE1 block. */
+	reg = readl(KWGBE_PORT_SERIAL_CONTROL1_REG(0));
+	reg &= ~(1 << 4);
+	writel(reg, KWGBE_PORT_SERIAL_CONTROL1_REG(0));
+	return 0;
+}
+
+int board_eth_init(struct bd_info *bis)
+{
+	return cpu_eth_init(bis);
+}
+
+int board_init(void)
+{
+	gd->bd->bi_boot_params = mvebu_sdram_bar(0) + 0x100;
+	return 0;
+}
diff --git a/configs/qnap_ts221_defconfig b/configs/qnap_ts221_defconfig
