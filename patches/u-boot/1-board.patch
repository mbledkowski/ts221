+CONFIG_SYS_KWD_CONFIG="board/qnap/ts221/kwbimage.cfg"
+CONFIG_TEXT_BASE=0x600000
+CONFIG_NR_DRAM_BANKS=2
+CONFIG_TARGET_QNAP_TS221=y
+# The Q703/TS-221 routes only Kirkwood egiga0.  The generic early-init option
+# blindly touches egiga1 too; that controller is gated on this board and a
+# read faults before U-Boot can initialize its real eth0 driver.
+# CONFIG_KIRKWOOD_EGIGA_INIT is not set
+CONFIG_ENV_SIZE=0x1000
